.vscode
dev-docs
node_modules

# exodus-app: generated Daml codegen and build output
exodus-app/generated/
exodus-app/web/dist/
*.tsbuildinfo

# Canton sandbox logs (written in the folder where `dpm sandbox` runs)
log/

# Local only (Farouk's laptop, never pushed): AI assistant files, frontend
# notes, render sources and the asset pipeline. The site only needs the built
# images in exodus-app/web/public/, which stay tracked.
CLAUDE.md
AGENTS.md
internals/
assets/
scripts/

# Python bytecode caches
__pycache__/

# exodus-app/api: local settings, build output and the generated Prisma client
.env
exodus-app/api/dist/
exodus-app/api/src/generated/

# Demo recordings (large; regenerate with docs/demo/record-demo.mjs)
docs/demo/recordings/
docs/demo/package*.json

# Media files: never commit audio or video. They are generated (voice-over by
# `npm run video:voice`, renders by `npm run video:render`, clips by
# record-demo.mjs) and would bloat the repository.
*.mp3
*.wav
*.m4a
*.mp4
*.webm
*.mov
exodus-app/video/out/
# The voice manifest only makes sense next to its MP3s, so it stays local too.
exodus-app/video/public/voice/

# The "scripts/" rule above is for local-only folders; the video's scripts
# (voice generation and its tests) are real code and must be tracked.
!exodus-app/video/scripts/