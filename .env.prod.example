# Settings for docker-compose.prod.yml. Copy to .env (next to this file) and fill in.
# .env is git-ignored: never commit the real one.

# The public name of the site: https://exodus.markets (normal HTTPS port, no :port
# in the URL). It and www.<it> both need an A record pointing to the server
# (docs/deploy.md); www just redirects here.
EXODUS_DOMAIN=exodus.markets
# Let's Encrypt writes here about certificate expiry (renewal is automatic).
LETSENCRYPT_EMAIL=

# The demo admin (approves access requests, dealer desk). At least 10 characters.
ADMIN_EMAIL=admin@exodus.local
ADMIN_PASSWORD=

# RAM ceiling for the Canton sandbox container (the Java heap gets half of it).
# 3g fits a 4 GB server; use 4g or more on 8 GB.
LEDGER_MEM_LIMIT=3g
