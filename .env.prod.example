# Settings for docker-compose.prod.yml. Copy to .env (next to this file) and fill in.
# .env is git-ignored: never commit the real one.

# The public name of the site. It needs an A record pointing to the server (docs/deploy.md).
EXODUS_DOMAIN=exodus.buoya.space
# The HTTPS port judges use: https://exodus.buoya.space:8443
EXODUS_HTTPS_PORT=8443
# Let's Encrypt writes here about certificate expiry.
LETSENCRYPT_EMAIL=

# The demo admin (approves access requests, dealer desk). At least 10 characters.
ADMIN_EMAIL=admin@exodus.local
ADMIN_PASSWORD=

# RAM ceiling for the Canton sandbox container (the Java heap gets half of it).
# 3g fits a 4 GB server next to the other project; use 4g or more on 8 GB.
LEDGER_MEM_LIMIT=3g
