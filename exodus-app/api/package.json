{
  "name": "@exodus/api",
  "version": "0.0.1",
  "description": "Exodus backend: accounts, access applications, admin approval, custodial Canton wallets, faucet and USYC price history.",
  "scripts": {
    "build": "prisma generate && tsc -p .",
    "start": "npm run build && node --enable-source-maps dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit -p .",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "npm run build && node dist/scripts/seed-admin.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@exodus/ledger": "^0.0.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0"
  }
}
