# Copy this file to .env (`cp .env.example .env`). The API checks every value at startup.

# PostgreSQL from docker-compose.yml (local demo credentials, not a real secret).
DATABASE_URL=postgresql://exodus:exodus@localhost:5432/exodus

# Canton JSON Ledger API (`npm run ledger`).
LEDGER_URL=http://localhost:7575

# Port of this API. The web app's Vite dev server forwards /api/* here.
PORT=3000

# How long a login lasts, in hours (168 = 7 days).
SESSION_TTL_HOURS=168
# Send the session cookie over HTTPS only. Keep false on http://localhost.
COOKIE_SECURE=false

# Faucet: simulated USDC per claim, and hours between two claims of one client.
FAUCET_AMOUNT=100.0
FAUCET_COOLDOWN_HOURS=24

# How often to read the USYC price for the chart, to check that every client
# wallet (party) still exists on the ledger (the sandbox forgets everything on
# restart), and to settle open USYC redeem requests as the fund.
PRICE_POLL_SECONDS=5
WALLET_CHECK_SECONDS=30
REDEEM_SETTLE_SECONDS=2

# Markets bots: the Operator matures markets and pays PT/YT claims, PT redeems
# and merges; the house dealer (Bank) answers RFQs and withdraws expired quotes.
MARKET_SETTLE_SECONDS=2
DEALER_POLL_SECONDS=1

# First admin account, created by `npm run db:seed`. Change the password.
ADMIN_EMAIL=admin@exodus.local
ADMIN_PASSWORD=change-me-now-please
