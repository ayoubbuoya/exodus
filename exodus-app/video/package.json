{
  "name": "@exodus/video",
  "version": "0.0.1",
  "description": "Explainer video for the HackCanton S3 judges, made with Remotion and ElevenLabs.",
  "scripts": {
    "voice": "node --env-file=.env scripts/voice.ts",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ExodusExplainer out/exodus-explainer.mp4",
    "still": "remotion still src/index.ts ExodusExplainer out/still.png",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"scripts/*.test.ts\""
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@remotion/cli": "4.0.529",
    "@remotion/media": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
