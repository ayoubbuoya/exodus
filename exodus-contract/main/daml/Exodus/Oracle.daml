-- | The oracle price feed for the Exodus demo: the USYC index and the demo clock.
--
-- Real USYC publishes its price through an oracle feed. Here the 'Oracle' demo
-- party publishes it instead. The index only goes up, because the fund only
-- earns interest: index 1.025 means 1 USYC = 1.025 USD.
--
-- simTime is a DEMO clock. Ledger time cannot be moved forward on a real
-- network, but the demo must show 6 months of yield in 3 minutes. So maturity
-- logic uses simTime, not ledger time (spec known gap 6).
--
-- TWO templates, because the price has two different jobs (spec gap 12):
--
--   RateFeed   the oracle's private WORKING STATE: the latest index and time.
--              Only the oracle sees it and writes to it. 'Publish' archives it
--              and creates the next one, which is fine: nobody else holds its id.
--
--   RateIndex  a read-only price SNAPSHOT that everyone else uses. Every
--              'Publish' creates a NEW snapshot and does NOT archive the old
--              ones. Each snapshot is usable for a short time window:
--
--                Snapshot #41  index 1.025   usable until 10:00:30
--                Snapshot #42  index 1.026   usable until 10:00:35   (published 5 s later)
--
--              If Alice read #41 and the oracle publishes #42 while her
--              Subscribe is on its way, #41 still works. Before this split,
--              every Publish archived the only price contract, and Alice's
--              command failed (the "stale rateCid" problem).
--
-- Canton Coin uses the same idea: several 'OpenMiningRound' contracts (which
-- carry the price) are open at the same time, each for a limited time.
--
-- The trade-off: while two snapshots are valid, a user may pick the older one.
-- Because the index only goes up, the older snapshot has a slightly lower
-- price. The short window keeps that small (see spec section 12).
--
-- How other contracts read the price (there are no contract keys in Daml 3.x):
-- the caller passes a RateIndex contract ID in, and the choice calls
-- 'fetchValidRate', which fails if the snapshot has expired.
module Exodus.Oracle where

import DA.Time (RelTime, addRelTime, seconds)


-- | The oracle's private working state: the latest index and demo time.
template RateFeed
  with
    oracle     : Party    -- who publishes and signs (the Oracle demo party)
    operator   : Party    -- copied into every snapshot, so the operator can read the price
    readers    : [Party]  -- copied into every snapshot, for example [Bank, Alice]
    instrument : Text     -- which asset this index is for, for example "USYC"
    index      : Decimal  -- the latest price of 1 token in USD, for example 1.025
    simTime    : Time     -- the latest demo clock, for example Jan 1 2027
    validFor   : RelTime  -- how long each snapshot stays usable, for example 30 seconds
  where
    ensure index > 0.0 && instrument /= "" && validFor > seconds 0

    -- Only the oracle. No observers on purpose: nobody else ever holds this
    -- contract's id, so nobody else's command can go stale when it changes.
    signatory oracle

    -- ---------------------------------------------------------------------
    -- Publish: move the feed forward and create a new price snapshot.
    --
    -- Example: on Jan 1 2027 the fund has earned 2.5%.
    --   Before: RateFeed(index = 1.00,  simTime = Oct 1 2026)
    --   Publish 1.025, Jan 1 2027
    --   After:  RateFeed(index = 1.025, simTime = Jan 1 2027)
    --           + new RateIndex snapshot (index = 1.025, usable for 'validFor')
    --   Older snapshots stay usable until their own validUntil.
    --
    -- Publishing the SAME values again is allowed. The oracle bot does this as
    -- a "heartbeat", so there is always a snapshot that has not expired.
    -- ---------------------------------------------------------------------
    choice Publish : (ContractId RateFeed, ContractId RateIndex)
      with
        newIndex   : Decimal
        newSimTime : Time
      controller oracle
      do
        -- We use >= and not >, so the oracle can move the clock forward while
        -- the index stays the same (or the other way around), and can send heartbeats.
        assertMsg "index can only go up" (newIndex >= index)
        assertMsg "simTime can only go forward" (newSimTime >= simTime)

        -- Snapshot times use LEDGER time (real time), not the demo clock:
        -- the window is about how fresh the data is, not about the demo date.
        now <- getTime

        -- Publish is consuming (the default), so this feed is already archived.
        newFeedCid <- create this with
          index = newIndex
          simTime = newSimTime

        snapshotCid <- create RateIndex with
          oracle = oracle
          operator = operator
          readers = readers
          instrument = instrument
          index = newIndex
          simTime = newSimTime
          publishedAt = now
          validUntil = addRelTime now validFor

        pure (newFeedCid, snapshotCid)


-- | A read-only price snapshot. Never changed, only archived after it expires.
template RateIndex
  with
    oracle      : Party    -- who published and signed it
    operator    : Party    -- runs the markets; reads the index to settle claims and call Mature
    readers     : [Party]  -- other parties that may read it, for example [Bank, Alice]
    instrument  : Text     -- for example "USYC"
    index       : Decimal  -- price of 1 token in USD, for example 1.025
    simTime     : Time     -- the demo clock at publish time, for example Jan 1 2027
    publishedAt : Time     -- LEDGER time of the Publish, for example 10:00:00
    validUntil  : Time     -- LEDGER time after which nobody may use it, for example 10:00:30
  where
    -- A zero or negative price makes no sense, and later formulas divide by
    -- the index (for example 'ptAmount / maturityIndex').
    ensure index > 0.0 && instrument /= "" && validUntil > publishedAt

    -- Only the oracle vouches for the price.
    signatory oracle

    -- The operator and the readers can see the index. This matters: in Daml, a
    -- party can only 'fetch' a contract it can see. When Alice calls
    -- 'Subscribe', the choice fetches the RateIndex as Alice, so Alice must be a reader.
    observer operator, readers

    -- ---------------------------------------------------------------------
    -- Expire: the oracle cleans up a snapshot that can no longer be used.
    -- The oracle bot calls this, so old snapshots do not pile up.
    -- ---------------------------------------------------------------------
    choice Expire : ()
      controller oracle
      do
        now <- getTime
        assertMsg "snapshot is still valid" (now >= validUntil)
        pure ()


-- | Fetch a price snapshot and check it has not expired. Every choice that
-- reads the price (Subscribe now, Split later) must use this, not a bare 'fetch'.
--
-- We only check the end of the window. Canton already guarantees that a
-- transaction's ledger time is never before the ledger time of a contract it
-- uses, so "now >= publishedAt" is always true.
fetchValidRate : ContractId RateIndex -> Update RateIndex
fetchValidRate rateCid = do
  rate <- fetch rateCid
  now <- getTime
  assertMsg "RateIndex snapshot has expired: read a newer one" (now < rate.validUntil)
  pure rate
