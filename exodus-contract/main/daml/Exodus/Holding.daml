-- | Mock assets for the Exodus demo: tokenized T-bill fund shares and USD cash.
--
-- One template, 'Holding', is used for both. The 'instrument' field tells
-- them apart:
--
--   Holding { issuer = FundIssuer, owner = Bank,  instrument = "TBILL", amount = 1000.0 }
--   Holding { issuer = CashIssuer, owner = Alice, instrument = "USD",   amount = 487.5  }
--
-- Think of each Holding contract as one "coin" or "banknote". You never edit a
-- coin in place. You spend it (archive it) and create new coins instead.
-- This is the UTXO model, the same idea Bitcoin uses.
module Exodus.Holding where


-- | What 'SplitOff' gives back: the piece you asked for and the change.
--
-- Example: splitting 400 off a 1000 holding gives
--   splitCid -> Holding with amount 400
--   restCid  -> Holding with amount 600
data SplitResult = SplitResult
  with
    splitCid : ContractId Holding
    restCid  : ContractId Holding
  deriving (Eq, Show)


template Holding
  with
    issuer     : Party    -- who created the asset and vouches for it (FundIssuer or CashIssuer)
    owner      : Party    -- who owns it right now and is allowed to move it
    instrument : Text     -- what the asset is, for example "TBILL" or "USD"
    amount     : Decimal  -- how much of it, for example 1000.0
  where
    -- 'ensure' is checked every time a Holding is created.
    -- If it is False, the whole transaction fails and nothing happens.
    -- So an empty or negative holding can never exist on the ledger.
    ensure amount > 0.0 && instrument /= ""

    -- SIGNATORY: the party (or parties) whose authority is needed to create
    -- this contract. The issuer signs, meaning "I, the issuer, say this asset
    -- is real". Only the issuer can create a Holding from nothing.
    signatory issuer

    -- OBSERVER: can see the contract but did not sign it.
    -- The owner must see their own holding to be able to use it.
    -- Nobody else (for example Alice looking at Bank's shares) can see it.
    -- That is Canton privacy: you only see contracts you are part of.
    observer owner

    -- ---------------------------------------------------------------------
    -- Transfer: give this whole holding to someone else.
    --
    -- Example: Bank transfers 400 TBILL to Alice.
    --   Before: Holding(owner = Bank,  amount = 400)
    --   After:  Holding(owner = Alice, amount = 400)   (the old one is archived)
    --
    -- This is a one-step transfer: Alice does not need to accept.
    -- That works because only the issuer is a signatory. Inside a choice,
    -- the choice runs with the authority of the contract's signatories
    -- (the issuer) plus the controller (the owner). That is enough to
    -- create the new Holding signed by the issuer.
    -- ---------------------------------------------------------------------
    choice Transfer : ContractId Holding
      with
        newOwner : Party
      -- CONTROLLER: who is allowed to exercise this choice. Only the owner.
      controller owner
      do
        -- Choices are "consuming" by default: exercising Transfer archives
        -- this contract first. Then we create the replacement.
        -- 'this with owner = newOwner' means "a copy of this contract with
        -- only the owner changed".
        create this with owner = newOwner

    -- ---------------------------------------------------------------------
    -- SplitOff: cut this holding into two pieces.
    --
    -- Example: Alice has 1000 USD but must pay exactly 487.5 USD.
    --   SplitOff 487.5  ->  splitCid = 487.5 USD, restCid = 512.5 USD
    -- She can then Transfer the 487.5 piece and keep the 512.5 piece.
    -- ---------------------------------------------------------------------
    choice SplitOff : SplitResult
      with
        splitAmount : Decimal
      controller owner
      do
        -- Both pieces must be greater than zero. A split of 0 or of the full
        -- amount would make a zero-sized piece, so we reject it here with a
        -- clear message. (The 'ensure' would also catch it, with a vaguer error.)
        assertMsg "splitAmount must be greater than 0" (splitAmount > 0.0)
        assertMsg "splitAmount must be less than the holding amount" (splitAmount < amount)

        splitCid <- create this with amount = splitAmount
        restCid  <- create this with amount = amount - splitAmount
        pure SplitResult with splitCid; restCid

    -- ---------------------------------------------------------------------
    -- MergeWith: join another holding into this one.
    --
    -- Example: Bank has two TBILL holdings, 400 and 600.
    --   MergeWith (the 600 one)  ->  one holding of 1000
    -- Both old contracts are archived and one new one is created.
    -- ---------------------------------------------------------------------
    choice MergeWith : ContractId Holding
      with
        otherCid : ContractId Holding
      controller owner
      do
        -- You cannot merge a holding with itself: that would double the amount.
        -- 'self' is the contract ID of the contract this choice runs on.
        assertMsg "cannot merge a holding with itself" (otherCid /= self)

        -- 'fetch' reads the other contract's data. The owner can do this
        -- because they are an observer of their own holdings.
        other <- fetch otherCid

        -- Only merge "the same kind of money". You must not be able to merge
        -- 100 USD into a TBILL holding and turn it into 100 TBILL.
        assertMsg "issuer must match" (other.issuer == issuer)
        assertMsg "owner must match" (other.owner == owner)
        assertMsg "instrument must match" (other.instrument == instrument)

        -- Archive the other holding. This contract is already being archived,
        -- because MergeWith is a consuming choice.
        archive otherCid

        create this with amount = amount + other.amount


-- | Round a number DOWN to 6 decimal places.
--
-- Every vault payout goes through this so the vault never pays out more than
-- it holds. Rounding up could make the vault go negative after many payouts.
--
--   roundDown6 24.3902439024  ==  24.390243   (normal rounding would give ...244)
--   roundDown6 476.1904761904 == 476.190476
--   roundDown6 5.0            ==   5.0
--
-- How it works, step by step with 24.3902439024:
--   1. Multiply by 1,000,000  ->  24390243.9024
--   2. 'floor' drops the fraction, rounding toward minus infinity -> 24390243 (an Int)
--   3. Turn it back into a Decimal and divide by 1,000,000  ->  24.390243
roundDown6 : Decimal -> Decimal
roundDown6 x = intToDecimal (floor (x * 1000000.0)) / 1000000.0
