-- | Tests for Exodus.Fund (Subscribe) and Exodus.Holding.payFrom.
--
-- Clients (Alice, Bank) cannot see the fund or the price snapshots. Like the
-- real app, every subscribe reads them as UsycIssuer and attaches them to the
-- client's command with explicit disclosure (see 'subscribe' below).
--
-- Run them with:
--   cd exodus-contract && dpm build --all
--   cd test && dpm test --files daml/Exodus/FundTest.daml
module Exodus.FundTest where

import DA.Assert ((===))  -- 'a === b' fails the test if a and b are not equal
import DA.Date (Month(..), date)
import DA.Time (addRelTime, seconds, time)
import Daml.Script
import Exodus.Access
import Exodus.Fund
import Exodus.Holding
import Exodus.Oracle


-- | Everything the fund tests need.
data FundSetup = FundSetup
  with
    usycIssuer  : Party
    usdcIssuer  : Party
    oracle      : Party
    operator    : Party
    alice       : Party
    bank        : Party
    fundCid     : ContractId UsycFund
    feedCid     : ContractId RateFeed      -- the oracle's feed, to publish newer snapshots
    rateCid     : ContractId RateIndex     -- a price snapshot at 1.025, valid for 30 seconds
    aliceAccess : ContractId ClientAccess  -- Alice's pass
    bankAccess  : ContractId ClientAccess  -- Bank's pass


-- | Parties, a price snapshot at 1.025 (Jan 1 2027), a fund, and passes for Alice and Bank.
--
-- The only RateIndex reader is UsycIssuer: 'Subscribe' fetches the price on
-- the fund's (UsycIssuer's) authority, because the client cannot see it.
setupFund : Script FundSetup
setupFund = do
  usycIssuer <- allocateParty "UsycIssuer"
  usdcIssuer <- allocateParty "UsdcIssuer"
  oracle     <- allocateParty "Oracle"
  operator   <- allocateParty "Operator"
  alice      <- allocateParty "Alice"
  bank       <- allocateParty "Bank"

  firstFeedCid <- submit oracle do
    createCmd RateFeed with
      oracle = oracle
      operator = operator
      readers = [usycIssuer]
      instrument = "USYC"
      index = 1.025
      simTime = time (date 2027 Jan 1) 0 0 0
      validFor = seconds 30
  (feedCid, rateCid) <- submit oracle do
    exerciseCmd firstFeedCid Publish with
      newIndex = 1.025
      newSimTime = time (date 2027 Jan 1) 0 0 0

  fundCid <- submit usycIssuer do
    createCmd UsycFund with
      usycIssuer = usycIssuer
      usdcIssuer = usdcIssuer
      oracle = oracle
      operator = operator

  aliceAccess <- grantAccess operator [usycIssuer, usdcIssuer] alice
  bankAccess <- grantAccess operator [usycIssuer, usdcIssuer] bank

  pure FundSetup with ..


-- | The operator approves 'client' (what the admin's "Approve" button does).
grantAccess : Party -> [Party] -> Party -> Script (ContractId ClientAccess)
grantAccess operator issuers client = submit operator do
  createCmd ClientAccess with
    operator = operator
    client = client
    issuers = issuers


-- | The issuer creates a holding for 'owner'.
issue : Party -> Party -> Text -> Decimal -> Script (ContractId Holding)
issue issuer owner instrument amount = submit issuer do
  createCmd Holding with
    issuer = issuer
    owner = owner
    instrument = instrument
    amount = amount


-- | All holdings of one instrument that 'owner' owns, as seen by 'owner'.
ownedAmounts : Party -> Text -> Script [Decimal]
ownedAmounts owner instrument = do
  holdings <- query @Holding owner
  pure [h.amount | (_, h) <- holdings, h.owner == owner, h.instrument == instrument]


-- | What the app attaches to a client's Subscribe: the fund and the price
-- snapshot, read by 'reader' (a party that can see both, normally UsycIssuer).
fundDisclosures : Party -> ContractId UsycFund -> ContractId RateIndex -> Script [Disclosure]
fundDisclosures reader fundCid rateCid = do
  Some fund <- queryDisclosure reader fundCid
  Some rate <- queryDisclosure reader rateCid
  pure [fund, rate]


-- | The Subscribe command, as the app would build it.
subscribeCmd : Party -> ContractId ClientAccess -> ContractId RateIndex -> [ContractId Holding] -> Decimal -> ContractId UsycFund -> Commands SubscribeResult
subscribeCmd subscriber accessCid rateCid usdcCids usdcAmount fundCid =
  exerciseCmd fundCid Subscribe with
    subscriber = subscriber
    accessCid = accessCid
    rateCid = rateCid
    usdcCids = usdcCids
    usdcAmount = usdcAmount


-- | 'subscriber' subscribes with the fund and 'rateCid' disclosed to it.
subscribe : FundSetup -> Party -> ContractId ClientAccess -> ContractId RateIndex -> [ContractId Holding] -> Decimal -> Script SubscribeResult
subscribe s subscriber accessCid rateCid usdcCids usdcAmount = do
  disclosures <- fundDisclosures s.usycIssuer s.fundCid rateCid
  submit (actAs subscriber <> discloseMany disclosures) do
    subscribeCmd subscriber accessCid rateCid usdcCids usdcAmount s.fundCid


-- | Same as 'subscribe', but the command must be rejected.
subscribeMustFail : FundSetup -> Party -> ContractId ClientAccess -> ContractId RateIndex -> [ContractId Holding] -> Decimal -> Script ()
subscribeMustFail s subscriber accessCid rateCid usdcCids usdcAmount = do
  disclosures <- fundDisclosures s.usycIssuer s.fundCid rateCid
  submitMustFail (actAs subscriber <> discloseMany disclosures) do
    subscribeCmd subscriber accessCid rateCid usdcCids usdcAmount s.fundCid


-- | The happy path from the plan: at index 1.025, Alice pays 500 USDC from
-- holdings of 600 and 400 and gets 487.804878 USYC plus 500 USDC change.
fundSubscribe : Script ()
fundSubscribe = script do
  s <- setupFund
  usdc600 <- issue s.usdcIssuer s.alice "USDC" 600.0
  usdc400 <- issue s.usdcIssuer s.alice "USDC" 400.0

  result <- subscribe s s.alice s.aliceAccess s.rateCid [usdc600, usdc400] 500.0

  -- Alice got 500 / 1.025 = 487.8048780487..., rounded DOWN to 487.804878 USYC.
  Some usyc <- queryContractId s.alice result.usycCid
  usyc.issuer     === s.usycIssuer
  usyc.owner      === s.alice
  usyc.instrument === "USYC"
  usyc.amount     === 487.804878

  -- Alice kept 500 USDC as change, in one holding.
  Some changeCid <- pure result.usdcChangeCid
  Some change <- queryContractId s.alice changeCid
  change.amount === 500.0
  aliceUsdc <- ownedAmounts s.alice "USDC"
  aliceUsdc === [500.0]

  -- The fund (UsycIssuer) received the 500 USDC.
  fundUsdc <- ownedAmounts s.usycIssuer "USDC"
  fundUsdc === [500.0]

  -- The input holdings were spent.
  None <- queryContractId s.alice usdc600
  None <- queryContractId s.alice usdc400

  -- The fund contract is still there (nonconsuming), so Alice can subscribe again.
  Some _ <- queryContractId s.usycIssuer s.fundCid
  pure ()


-- | Paying exactly the amount of the inputs leaves no change.
fundSubscribeExact : Script ()
fundSubscribeExact = script do
  s <- setupFund
  usdc500 <- issue s.usdcIssuer s.bank "USDC" 500.0

  result <- subscribe s s.bank s.bankAccess s.rateCid [usdc500] 500.0

  result.usdcChangeCid === None
  bankUsdc <- ownedAmounts s.bank "USDC"
  bankUsdc === []
  bankUsyc <- ownedAmounts s.bank "USYC"
  bankUsyc === [487.804878]
  pure ()


-- | Spec gap 12. A newer price does NOT break a subscribe that uses an older
-- snapshot, as long as that snapshot is inside its 30-second window.
--
--   t = 0 s   snapshot A: index 1.025, valid until t = 30 s   (from setupFund)
--   t = 20 s  snapshot B: index 1.03,  valid until t = 50 s
--   t = 20 s  subscribe with A -> works, at the OLDER price (the trade-off)
--   t = 31 s  subscribe with A -> fails, A has expired
--   t = 31 s  subscribe with B -> works, at the new price
fundOldSnapshot : Script ()
fundOldSnapshot = script do
  s <- setupFund
  usdc1 <- issue s.usdcIssuer s.alice "USDC" 100.0
  usdc2 <- issue s.usdcIssuer s.alice "USDC" 100.0
  usdc3 <- issue s.usdcIssuer s.alice "USDC" 100.0

  passTime (seconds 20)
  (_, snapshotB) <- submit s.oracle do
    exerciseCmd s.feedCid Publish with
      newIndex = 1.03
      newSimTime = time (date 2027 Feb 1) 0 0 0

  -- The old snapshot A still works: 100 / 1.025 = 97.5609756..., so 97.560975 USYC.
  -- Before the fix, this command failed because A had been archived.
  resultA <- subscribe s s.alice s.aliceAccess s.rateCid [usdc1] 100.0
  Some usycA <- queryContractId s.alice resultA.usycCid
  usycA.amount === 97.560975

  -- 11 seconds later, A is past its window and is refused. Nothing moves.
  passTime (seconds 11)
  subscribeMustFail s s.alice s.aliceAccess s.rateCid [usdc2] 100.0
  Some _ <- queryContractId s.alice usdc2

  -- The newer snapshot B works, at the new price: 100 / 1.03 = 97.0873786..., so 97.087378.
  resultB <- subscribe s s.alice s.aliceAccess snapshotB [usdc3] 100.0
  Some usycB <- queryContractId s.alice resultB.usycCid
  usycB.amount === 97.087378
  pure ()


-- | Things that must NOT work. After each one, nothing has moved.
fundFailures : Script ()
fundFailures = script do
  s <- setupFund
  usdc <- issue s.usdcIssuer s.alice "USDC" 400.0

  let aliceMustFail = subscribeMustFail s s.alice s.aliceAccess

  -- Not enough USDC: she has 400 and wants to pay 500.
  aliceMustFail s.rateCid [usdc] 500.0

  -- Zero, and an amount so small it buys less than 0.000001 USYC.
  aliceMustFail s.rateCid [usdc] 0.0
  aliceMustFail s.rateCid [usdc] 0.0000001

  -- No input holdings at all.
  aliceMustFail s.rateCid [] 100.0

  -- A FAKE RateIndex: Alice publishes her own index of 0.0001 to mint
  -- 1,000,000 USYC for 100 USDC. The fund only trusts its own oracle.
  -- (Alice made it, so she can see it; UsycIssuer is a reader so the fetch is allowed.)
  now <- getTime
  fakeRateCid <- submit s.alice do
    createCmd RateIndex with
      oracle = s.alice
      operator = s.alice
      readers = [s.usycIssuer]
      instrument = "USYC"
      index = 0.0001
      simTime = time (date 2027 Jan 1) 0 0 0
      publishedAt = now
      validUntil = addRelTime now (seconds 30)
  aliceMustFail fakeRateCid [usdc] 100.0

  -- A RateIndex from the right oracle, but for another instrument.
  otherRateCid <- submit s.oracle do
    createCmd RateIndex with
      oracle = s.oracle
      operator = s.operator
      readers = [s.usycIssuer]
      instrument = "OTHER"
      index = 1.0
      simTime = time (date 2027 Jan 1) 0 0 0
      publishedAt = now
      validUntil = addRelTime now (seconds 30)
  aliceMustFail otherRateCid [usdc] 100.0

  -- Paying with USYC instead of USDC.
  aliceUsyc <- issue s.usycIssuer s.alice "USYC" 1000.0
  aliceMustFail s.rateCid [aliceUsyc] 100.0

  -- Paying with home-made "USDC" from an unknown issuer.
  fakeIssuer <- allocateParty "FakeIssuer"
  fakeUsdc <- issue fakeIssuer s.alice "USDC" 1000.0
  aliceMustFail s.rateCid [fakeUsdc] 100.0

  -- Paying with someone else's USDC (Bank's).
  bankUsdc <- issue s.usdcIssuer s.bank "USDC" 1000.0
  aliceMustFail s.rateCid [bankUsdc] 100.0

  -- Alice cannot subscribe in Bank's name, even with Bank's pass.
  disclosures <- fundDisclosures s.usycIssuer s.fundCid s.rateCid
  submitMustFail (actAs s.alice <> discloseMany disclosures) do
    subscribeCmd s.bank s.bankAccess s.rateCid [bankUsdc] 100.0 s.fundCid

  -- Nothing moved: Alice's real 400 USDC holding is untouched, and she has no
  -- new USYC (only the 1000 USYC issued above). She also still owns the fake
  -- "USDC", so we check the real holding by its id, not by instrument name.
  Some aliceUsdc <- queryContractId s.alice usdc
  aliceUsdc.amount === 400.0
  aliceUsycAmounts <- ownedAmounts s.alice "USYC"
  aliceUsycAmounts === [1000.0]
  pure ()


-- | The access pass is the whitelist: without a valid pass of her own, a
-- party cannot subscribe.
fundNeedsAccessPass : Script ()
fundNeedsAccessPass = script do
  s <- setupFund

  -- Carol has USDC but was never approved. She tries Alice's pass: refused
  -- ("access pass belongs to another client"). Carol cannot even see Alice's
  -- pass; here the test hands it to her command to prove the contract checks it.
  carol <- allocateParty "Carol"
  carolUsdc <- issue s.usdcIssuer carol "USDC" 1000.0
  Some alicePass <- queryDisclosure s.alice s.aliceAccess
  fundAndRate <- fundDisclosures s.usycIssuer s.fundCid s.rateCid
  submitMustFail (actAs carol <> discloseMany (alicePass :: fundAndRate)) do
    subscribeCmd carol s.aliceAccess s.rateCid [carolUsdc] 100.0 s.fundCid

  -- Carol makes her own "pass" (operator = Carol). The fund only accepts
  -- passes from its operator: refused.
  carolFakePass <- submit carol do
    createCmd ClientAccess with operator = carol; client = carol; issuers = []
  subscribeMustFail s carol carolFakePass s.rateCid [carolUsdc] 100.0

  -- The admin approves Carol: now it works. 100 / 1.025 = 97.560975 USYC.
  carolAccess <- grantAccess s.operator [s.usycIssuer, s.usdcIssuer] carol
  result <- subscribe s carol carolAccess s.rateCid [carolUsdc] 100.0
  Some usyc <- queryContractId carol result.usycCid
  usyc.amount === 97.560975

  -- The admin revokes Carol: her next subscribe is refused, her USYC stays hers.
  submit s.operator do exerciseCmd carolAccess Revoke
  Some carolChange <- pure result.usdcChangeCid
  subscribeMustFail s carol carolAccess s.rateCid [carolChange] 100.0
  carolUsyc <- ownedAmounts carol "USYC"
  carolUsyc === [97.560975]
  pure ()


-- | Subscribe reads the price on UsycIssuer's authority, so UsycIssuer must be
-- a reader of the snapshot. A snapshot without it cannot be used.
fundNeedsIssuerAsRateReader : Script ()
fundNeedsIssuerAsRateReader = script do
  s <- setupFund
  usdc <- issue s.usdcIssuer s.alice "USDC" 100.0

  -- A second feed from the same oracle, but its snapshots are readable by the operator only.
  wrongFeedCid <- submit s.oracle do
    createCmd RateFeed with
      oracle = s.oracle
      operator = s.operator
      readers = []
      instrument = "USYC"
      index = 1.025
      simTime = time (date 2027 Jan 1) 0 0 0
      validFor = seconds 30
  (_, hiddenRateCid) <- submit s.oracle do
    exerciseCmd wrongFeedCid Publish with
      newIndex = 1.025
      newSimTime = time (date 2027 Jan 1) 0 0 0

  -- Alice gets both contracts disclosed, but nobody who authorizes the
  -- Subscribe (Alice, UsycIssuer) is a stakeholder of the snapshot, so
  -- Canton refuses the fetch.
  Some fund <- queryDisclosure s.usycIssuer s.fundCid
  Some rate <- queryDisclosure s.oracle hiddenRateCid
  submitMustFail (actAs s.alice <> discloseMany [fund, rate]) do
    subscribeCmd s.alice s.aliceAccess hiddenRateCid [usdc] 100.0 s.fundCid
  pure ()


-- | Privacy: a subscription is visible only to the parties involved, and
-- clients see neither the fund, nor the price, nor each other.
fundPrivacy : Script ()
fundPrivacy = script do
  s <- setupFund
  usdc <- issue s.usdcIssuer s.alice "USDC" 1000.0

  result <- subscribe s s.alice s.aliceAccess s.rateCid [usdc] 500.0

  -- Alice used the fund and the price, but still sees neither: they were
  -- only disclosed to her command. She sees her own pass, not Bank's.
  aliceFunds <- query @UsycFund s.alice
  aliceFunds === []
  aliceRates <- query @RateIndex s.alice
  aliceRates === []
  alicePasses <- query @ClientAccess s.alice
  [p.client | (_, p) <- alicePasses] === [s.alice]

  -- Bank sees none of Alice's holdings, old or new.
  None <- queryContractId s.bank result.usycCid
  bankHoldings <- query @Holding s.bank
  bankHoldings === []

  -- UsdcIssuer sees the USDC it issued, but not Alice's new USYC.
  None <- queryContractId s.usdcIssuer result.usycCid
  usdcIssuerHoldings <- query @Holding s.usdcIssuer
  [h.instrument | (_, h) <- usdcIssuerHoldings] === ["USDC", "USDC"]

  -- The Oracle and the Operator see no holdings at all.
  oracleHoldings <- query @Holding s.oracle
  oracleHoldings === []
  operatorHoldings <- query @Holding s.operator
  operatorHoldings === []
  pure ()
