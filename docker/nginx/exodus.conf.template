# The public Exodus site (docker-compose.prod.yml). The nginx image fills in the
# ${EXODUS_...} and ${SSL_...} values at start; the $lowercase ones are nginx's own.
#
# nginx does the job of `vite preview` in the demo compose: it serves the built
# web app and forwards /api to the NestJS backend and /v2 to the Canton JSON
# Ledger API (used by /lab), so the browser sees one origin.
#
# Three server blocks:
#   port 80                       Let's Encrypt's HTTP check, everything else -> https://
#   port 443, www.<domain>        -> https://<domain> (one public name)
#   port 443, <domain>            the app

# Docker's DNS. Looking the containers up per request (not once at start) keeps
# nginx working when the api container restarts with a new IP.
resolver 127.0.0.11 valid=10s ipv6=off;

# Plain HTTP. Only used for two things:
#  1. Let's Encrypt's HTTP-01 check: certbot (the certbot and certbot-renew
#     services) writes a token file into the shared `certbot-www` volume, and
#     Let's Encrypt downloads it from http://<domain>/.well-known/acme-challenge/<token>.
#     This is how the certificate is issued and renewed without a DNS record.
#  2. Sending visitors who type http://exodus.markets to the https:// site.
server {
    listen 80;
    server_name ${EXODUS_DOMAIN} www.${EXODUS_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${EXODUS_DOMAIN}$request_uri;
    }
}

# https://www.exodus.markets/... -> https://exodus.markets/... so the site has
# one name (and one session cookie). The certificate covers both names.
server {
    listen 443 ssl;
    http2 on;
    server_name www.${EXODUS_DOMAIN};

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;

    return 301 https://${EXODUS_DOMAIN}$request_uri;
}

server {
    # `default_server`: a visitor who opens https://<server IP> also lands here.
    listen 443 ssl default_server;
    http2 on;
    server_name ${EXODUS_DOMAIN};

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    # http:// sent to port 443 by mistake: send the browser to https://.
    error_page 497 =301 https://$host$request_uri;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    set $api    http://api:3000;
    set $ledger http://ledger:7575;

    location /api/ {
        proxy_pass $api;
        proxy_set_header Host $host;
        # The API rate-limits by the last address in this header (see api/src/main.ts).
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /v2/ {
        proxy_pass $ledger;
    }

    root /usr/share/nginx/html;

    # Vite puts a content hash in every file name under /assets, so they never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The app's own routes (/app, /markets/..., /lab) are all index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
