# The public Exodus site (docker-compose.prod.yml). The nginx image fills in the
# ${EXODUS_...} and ${SSL_...} values at start; the $lowercase ones are nginx's own.
#
# nginx does the job of `vite preview` in the demo compose: it serves the built
# web app and forwards /api to the NestJS backend and /v2 to the Canton JSON
# Ledger API (used by /lab), so the browser sees one origin.

# Docker's DNS. Looking the containers up per request (not once at start) keeps
# nginx working when the api container restarts with a new IP.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 443 ssl;
    http2 on;
    server_name ${EXODUS_DOMAIN};

    ssl_certificate     ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    # http:// on this HTTPS port: send the browser to https:// on the public port.
    error_page 497 =301 https://$host:${EXODUS_HTTPS_PORT}$request_uri;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    set $api    http://api:3000;
    set $ledger http://ledger:7575;

    location /api/ {
        proxy_pass $api;
        proxy_set_header Host $host;
        # The API rate-limits by the last address in this header (see api/src/main.ts).
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /v2/ {
        proxy_pass $ledger;
    }

    root /usr/share/nginx/html;

    # Vite puts a content hash in every file name under /assets, so they never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The app's own routes (/app, /markets/..., /lab) are all index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
